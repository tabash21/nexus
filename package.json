{
  "name": "nexus",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:services": "turbo run dev --filter=@nexus/api --filter=@nexus/worker --filter=@nexus/enrichment-worker",
    "dev:api": "turbo run dev --filter=@nexus/api",
    "dev:worker": "turbo run dev --filter=@nexus/worker",
    "dev:enrichment-worker": "turbo run dev --filter=@nexus/enrichment-worker",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.tools.json",
    "test": "turbo run build && vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "format": "prettier --write apps/worker apps/enrichment-worker packages",
    "format:check": "prettier --check apps/worker apps/enrichment-worker packages",
    "check": "npm run format:check && turbo run build typecheck && tsc -p tsconfig.tools.json && npm run db:check && vitest run",
    "check:services": "turbo run build typecheck --filter=!@nexus/dashboard && tsc -p tsconfig.tools.json && npm run db:check && vitest run",
    "local": "docker compose -f compose.yaml -f compose.local.yaml up -d --build --wait",
    "local:down": "docker compose -f compose.yaml -f compose.local.yaml down",
    "local:logs": "docker compose -f compose.yaml -f compose.local.yaml logs --tail 100 -f",
    "local:dev": "npm run infra:up && npm run db:prepare && npm run setup && npm run dev:services",
    "setup": "turbo run build --filter=@nexus/database --filter=@nexus/kafka && node --env-file-if-exists=.env scripts/setup/index.mjs",
    "setup:local": "docker compose -f compose.yaml -f compose.local.yaml run --build --rm setup",
    "infra:up": "docker compose -f compose.yaml -f compose.local.yaml up -d --build --wait postgres kafka s3 && docker compose -f compose.yaml -f compose.local.yaml stop api worker enrichment-worker",
    "infra:down": "npm run local:down",
    "db:migrate": "turbo run build --filter=@nexus/database && node --env-file-if-exists=.env packages/database/dist/migrate.js",
    "db:generate": "npm run build --workspace @nexus/database && drizzle-kit generate --config packages/database/drizzle.config.ts",
    "topics:setup": "turbo run build --filter=@nexus/kafka && node --env-file-if-exists=.env scripts/setup/topics.mjs",
    "demo:publish": "node --env-file-if-exists=.env --import tsx scripts/demo/publish.ts",
    "agents:verify": "node --env-file-if-exists=.env --conditions=development --import tsx scripts/agents/verify.ts",
    "agents:example": "node --env-file-if-exists=.env --conditions=development --import tsx scripts/agents/example.ts",
    "replay": "node --env-file-if-exists=.env --import tsx scripts/maintenance/replay.ts",
    "ui": "npm run dev --workspace=@nexus/dashboard",
    "db:check": "npm run build --workspace @nexus/database && node scripts/database/check-models.mjs",
    "db:verify": "npm run build --workspace @nexus/database && node --env-file-if-exists=.env scripts/database/verify.mjs",
    "db:prepare": "npm run db:check && npm run db:migrate && npm run db:verify"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.6",
    "@electric-sql/pglite-postgis": "0.0.8",
    "@types/node": "^24.0.0",
    "drizzle-kit": "0.31.11",
    "prettier": "^3.5.3",
    "tsx": "^4.20.0",
    "turbo": "2.11.7",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "avsc": "5.7.9",
    "kafkajs": "2.2.4"
  }
}
