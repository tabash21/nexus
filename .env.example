# Local run: copy to .env. Other pipeline settings have defaults.
# These localhost addresses are for host-side development and scripts.
# compose.local.yaml supplies container addresses and local S3 settings.
DATABASE_URL=postgresql://nexus:nexus_local@localhost:5432/nexus
API_TOKEN=local-development-token-change-me
KAFKA_BROKERS=localhost:9092
KAFKA_STREAM_ID=local-kafka-v1

# One topic and consumer group per configured platform.
KAFKA_PLATFORMS=telegram
# ,x,news,reddit,threads,instagram,tiktok,youtube,bluesky,facebook
KAFKA_GROUP_ID=nexus-items-v1
# Every platform has raw and sim consumers: raw is reality 0, sim is always 1.
# Optional JSON array: [{"platform":"telegram","topic":"raw.telegram.v1","groupId":"nexus-items-v1.telegram","mode":"real","adapter":"provisional.v1"}]
# KAFKA_SOURCES=

# Optional agent infrastructure: configure ONE authentication method.
# Method 1: Bedrock bearer token (takes precedence when set).
AWS_BEARER_TOKEN_BEDROCK=
# Method 2: IAM credentials (both values required when no bearer token is set).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required only when the IAM credentials are temporary.
AWS_SESSION_TOKEN=
# The agent preset fixes the region to il-central-1; AWS_REGION is not required.
# See scripts/agents/README.md for verification and usage examples.
