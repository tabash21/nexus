{
  "name": "nexus",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo watch dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.tools.json",
    "test": "turbo run build && vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "local": "docker compose -f compose.yaml -f compose.local.yaml up -d --build --wait",
    "local:down": "docker compose -f compose.yaml -f compose.local.yaml down",
    "local:logs": "docker compose -f compose.yaml -f compose.local.yaml logs --tail 100 -f",
    "local:dev": "docker compose -f compose.yaml -f compose.local.yaml stop api worker && npm run infra:up && npm run setup:local && npm run dev",
    "setup:local": "docker compose -f compose.yaml -f compose.local.yaml run --build --rm setup",
    "infra:up": "docker compose -f compose.yaml -f compose.local.yaml up -d --build --wait postgres kafka s3 connect",
    "infra:down": "npm run local:down",
    "db:migrate": "turbo run build --filter=@nexus/database && node --env-file-if-exists=.env packages/database/dist/migrate.js",
    "topics:setup": "node --env-file-if-exists=.env scripts/setup/topics.mjs",
    "demo:publish": "node --env-file-if-exists=.env --import tsx scripts/demo/publish.ts",
    "archive:register": "node --env-file-if-exists=.env scripts/setup/register-archive.mjs",
    "replay": "node --env-file-if-exists=.env --import tsx scripts/maintenance/replay.ts",
    "ui": "turbo run build --filter=@nexus/dashboard && node --env-file-if-exists=.env apps/dashboard/dist/index.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "turbo": "2.11.7",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "avsc": "5.7.9",
    "kafkajs": "2.2.4"
  }
}
