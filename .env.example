# Local settings only. Copy to .env; deployment injects its own variables.
NODE_ENV=development
COMPOSE_PROJECT_NAME=nexus
NODE_IMAGE=node:24-bookworm-slim
NEXUS_IMAGE=nexus:local
CONNECT_IMAGE=nexus-connect:local
POSTGRES_IMAGE=postgres:17.6
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_local
POSTGRES_DB=nexus
POSTGRES_PORT=5432
# Host-side tools use localhost; compose.local.yaml sets internal addresses.
DATABASE_URL=postgresql://nexus:nexus_local@localhost:5432/nexus
API_HOST=127.0.0.1
API_BIND_ADDRESS=127.0.0.1
API_PORT=3000
API_TOKEN=local-development-token-change-me
KAFKA_IMAGE=apache/kafka:4.0.2
KAFKA_PORT=9092
KAFKA_ADVERTISED_HOST=localhost
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_BROKERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# Kafka Connect's Java login configuration, only needed for SASL deployments.
KAFKA_SASL_JAAS_CONFIG=
KAFKA_TOPIC=osint.raw.v1
KAFKA_DLQ_TOPIC=osint.quarantine.v1
KAFKA_GROUP_ID=nexus-normalizer-v1
KAFKA_STREAM_ID=local-kafka-v1
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1
CONNECT_GROUP_ID=nexus-connect
CONNECT_REPLICATION_FACTOR=1
CONNECT_CONFIG_STORAGE_TOPIC=_nexus-connect-configs
CONNECT_OFFSET_STORAGE_TOPIC=_nexus-connect-offsets
CONNECT_STATUS_STORAGE_TOPIC=_nexus-connect-status
CONNECT_PORT=8083
CONNECT_URL=http://localhost:8083

# Archive settings are applied by npm run archive:register.
S3_TARGET=local
S3_BUCKET=nexus-raw
S3_REGION=us-east-1
S3_PORT=4566
# Docker-internal endpoint; localhost:4566 is only for host-side tools.
S3_ENDPOINT=http://s3:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_SESSION_TOKEN=
