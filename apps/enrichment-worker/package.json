{
  "name": "@nexus/enrichment-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --tsconfig tsconfig.json --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nexus/contracts": "*",
    "@nexus/database": "*",
    "@nexus/kafka": "*",
    "avsc": "5.7.9",
    "kafkajs": "2.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
